generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(160)
  address     String         @db.VarChar(255)
  city        String         @db.VarChar(100)
  state       String         @db.VarChar(100)
  postalCode  String         @db.VarChar(12)
  ownerName   String         @db.VarChar(120)
  ownerMobile String         @db.VarChar(15)
  ownerId     String?
  companyId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       PropertyOwner? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assets      Asset[]

  @@index([createdAt])
  @@index([ownerId])
  @@index([companyId])
  @@map("buildings")
}

model PropertyOwner {
  id            String              @id @default(cuid())
  fullName      String              @db.VarChar(120)
  mobileNumber  String              @unique @db.VarChar(15)
  email         String?             @db.VarChar(254)
  passwordHash  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  buildings     Building[]
  companies     Company[]
  tenants       Tenant[]
  termTemplates OwnerTermTemplate[]

  @@map("property_owners")
}

model Company {
  id        String        @id @default(cuid())
  ownerId   String
  name      String        @db.VarChar(160)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  owner     PropertyOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  buildings Building[]

  @@index([ownerId])
  @@map("companies")
}

model Asset {
  id                 String                      @id @default(cuid())
  buildingId         String
  name               String                      @db.VarChar(120)
  assetType          String                      @db.VarChar(60)
  unitNumber         String                      @db.VarChar(40)
  monthlyRent        Int
  securityDeposit    Int                         @default(0)
  externalBuildingId String?                     @db.VarChar(40)
  ward               String?                     @db.VarChar(20)
  roomNumber         String?                     @db.VarChar(40)
  ksmartBuildingId   String?                     @db.VarChar(60)
  ksrbId             String?                     @db.VarChar(60)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  building           Building                    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenants            AssetTenant[]
  agreements         RentalAgreement[]
  termTemplates      AssetTermTemplate[]
  renewalDismissals  AgreementRenewalDismissal[]
  agreementCounter   AgreementCounter?

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@map("assets")
}

model Tenant {
  id                String                      @id @default(cuid())
  ownerId           String
  fullName          String                      @db.VarChar(120)
  mobileNumber      String?                     @unique @db.VarChar(15)
  businessName      String?                     @db.VarChar(160)
  fullAddress       String?                     @db.Text
  aadhaarNumber     String?                     @db.VarChar(20)
  fatherName        String?                     @db.VarChar(120)
  email             String?                     @db.VarChar(254)
  photoDataUrl      String?                     @db.Text
  publicShareTokenHash String?                   @unique
  passwordHash      String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  owner             PropertyOwner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assets            AssetTenant[]
  agreements        RentalAgreement[]
  renewalDismissals AgreementRenewalDismissal[]

  @@index([ownerId])
  @@map("tenants")
}

model AssetTenant {
  id        String   @id @default(cuid())
  assetId   String
  tenantId  String
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([assetId, tenantId])
  @@index([tenantId])
  @@map("asset_tenants")
}

model RentalAgreement {
  id               String    @id @default(cuid())
  agreementNumber  String    @unique @db.VarChar(40)
  assetId          String
  tenantId         String
  agreementYear    Int
  startDate        DateTime  @db.Date
  endDate          DateTime  @db.Date
  monthlyRent      Int
  securityDeposit  Int       @default(0)
  terms            String    @db.Text
  importantTerms   String    @default("") @db.Text
  status           String    @default("ACTIVE") @db.VarChar(20)
  ownerApprovedAt  DateTime? @db.Timestamptz(6)
  tenantApprovedAt DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now())
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, assetId, agreementYear])
  @@index([assetId, startDate, endDate])
  @@index([tenantId, startDate])
  @@map("rental_agreements")
}

model ArchivedRentalAgreement {
  id                  String   @id @default(cuid())
  ownerId             String
  originalAgreementId String   @unique
  agreementNumber     String   @db.VarChar(40)
  agreementYear       Int
  startDate           DateTime @db.Date
  endDate             DateTime @db.Date
  monthlyRent         Int
  securityDeposit     Int      @default(0)
  terms               String   @db.Text
  importantTerms      String   @default("") @db.Text
  status              String   @db.VarChar(20)
  ownerApprovedAt     DateTime? @db.Timestamptz(6)
  tenantApprovedAt    DateTime? @db.Timestamptz(6)
  tenantName          String   @db.VarChar(120)
  tenantMobileNumber  String?  @db.VarChar(15)
  assetName           String   @db.VarChar(120)
  assetType           String   @db.VarChar(60)
  unitNumber          String   @db.VarChar(40)
  buildingName        String   @db.VarChar(160)
  buildingAddress     String   @db.VarChar(255)
  city                String   @db.VarChar(100)
  state               String   @db.VarChar(100)
  templateTerms       String   @db.Text
  createdAt           DateTime
  archivedAt          DateTime @default(now())

  @@index([ownerId, archivedAt])
  @@map("archived_rental_agreements")
}

model AgreementRenewalDismissal {
  assetId       String
  tenantId      String
  agreementYear Int
  createdAt     DateTime @default(now())
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([assetId, tenantId, agreementYear])
  @@index([tenantId])
  @@map("agreement_renewal_dismissals")
}

model AgreementCounter {
  assetId   String @id
  nextValue Int    @default(1)
  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model OwnerTermTemplate {
  id        String              @id @default(cuid())
  ownerId   String
  name      String              @db.VarChar(120)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  owner     PropertyOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     OwnerTermItem[]
  assets    AssetTermTemplate[]

  @@index([ownerId, createdAt])
  @@map("owner_term_templates")
}

model OwnerTermItem {
  id                   String            @id @default(cuid())
  templateId           String
  position             Int
  text                 String            @db.VarChar(1000)
  importantObligation  Boolean           @default(false)
  createdAt            DateTime          @default(now())
  template             OwnerTermTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("owner_term_items")
}

model AssetTermTemplate {
  assetId    String
  templateId String
  createdAt  DateTime          @default(now())
  asset      Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  template   OwnerTermTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([assetId, templateId])
  @@index([templateId])
  @@map("asset_term_templates")
}
